    {
        "id": "validate_recipient",
        "type": "function",
        "z": "bd6bb11c58fb203e",
        "name": "Validate & Prepare",
        "func": "const payload = msg.payload;\n\nif (!payload.email || !payload.email.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/)) {\n    msg.statusCode = 400;\n    msg.payload = { success: false, error: 'Invalid email address' };\n    return [null, msg];\n}\n\nconst newRecipient = {\n    email: payload.email,\n    name: payload.name || null,\n    is_active: payload.is_active !== false,\n    notification_types: payload.notification_types || { button: true, pir: true, pir_alert: true, voice: true }\n};\n\nmsg.url = 'https://xznnnklhqkccylxxzsdh.supabase.co/rest/v1/email_recipients';\nmsg.method = 'POST';\nmsg.payload = newRecipient;\nmsg.headers = {\n    'apikey': 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh6bm5ua2xocWtjY3lseHh6c2RoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjY5OTEzMDAsImV4cCI6MjA4MjU2NzMwMH0.qucNiuvWiQc-ntPAuBiNKZAphhnReb3e4gnUAhEE1Z8',\n    'Authorization': 'Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh6bm5ua2xocWtjY3lseHh6c2RoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjY5OTEzMDAsImV4cCI6MjA4MjU2NzMwMH0.qucNiuvWiQc-ntPAuBiNKZAphhnReb3e4gnUAhEE1Z8',\n    'Content-Type': 'application/json',\n    'Prefer': 'return=representation'\n};\n\nreturn [msg, null];",
        "outputs": 2,
