        "z": "a7b8c9d0e1f2g3h4",
        "name": "Format Sensor Response",
        "func": "let data = msg.payload;\nif (typeof data === 'string') {\n    try {\n        data = JSON.parse(data);\n    } catch (e) {\n        data = [];\n    }\n}\n\nif (Array.isArray(data) && data.length > 0) {\n    msg.payload = {\n        success: true,\n        data: data[0],\n        timestamp: new Date().toISOString()\n    };\n} else {\n    msg.payload = {\n        success: false,\n        data: null,\n        message: 'No sensor data found'\n    };\n}\n\nmsg.statusCode = 200;\nreturn msg;",
