    {
        "id": "d79d32f14038a8f2",
        "type": "http in",
        "z": "bd6bb11c58fb203e",
        "name": "POST /api/commands/speak",
        "url": "/api/commands/speak",
        "method": "post",
        "upload": false,
        "skipBodyParsing": false,
        "swaggerDoc": "",
        "x": 200,
        "y": 1400,
        "wires": [
            [
                "9a6f9dfc1cf6fb65"
