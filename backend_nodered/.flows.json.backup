        "z": "bd6bb11c58fb203e",
        "name": "Format Success Response",
        "func": "let data = msg.payload;\nif (typeof data === 'string') {\n    try {\n        data = JSON.parse(data);\n    } catch (e) {\n        data = [];\n    }\n}\n\nif (Array.isArray(data) && data.length > 0) {\n    msg.statusCode = 200;\n    msg.payload = {\n        success: true,\n        message: \"Quick response updated successfully\",\n        data: data[0]\n    };\n} else {\n    msg.statusCode = 404;\n    msg.payload = {\n        success: false,\n        error: \"Quick response not found\",\n        code: \"NOT_FOUND\"\n    };\n}\n\nreturn msg;",
