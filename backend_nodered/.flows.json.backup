    {
        "id": "filter_dnd_button",
        "type": "function",
        "z": "bd6bb11c58fb203e",
        "name": "Filter by DND",
        "func": "let settings = JSON.parse(msg.payload);\nif (Array.isArray(settings)) settings = settings[0];\n\nif (settings.do_not_disturb === true) {\n    node.warn('🔕 DND enabled - skipping button email');\n    return null;\n}\n\n// Proceed with email\nmsg.eventData.notifications_enabled = settings.notifications_enabled;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
