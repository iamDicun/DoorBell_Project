    {
        "id": "send_button_emails",
        "type": "function",
        "z": "bd6bb11c58fb203e",
        "name": "Format Button Emails",
        "func": "// Parse recipients (handle both string and object)\n// Đoạn này anh làm tốt rồi, giữ nguyên nè\nlet recipients = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload;\n\nif (!Array.isArray(recipients) || recipients.length === 0) {\n    node.warn('No active recipients for button notification');\n    return null;\n}\n\nconst eventData = msg.eventData || { timestamp: Date.now() }; // Em thêm cái fallback cho chắc cốp\nconst messages = [];\n\nfor (const recipient of recipients) {\n    messages.push({\n        // QUAN TRỌNG: Đưa mấy cái này ra ngoài root của msg\n        to: recipient.email,\n        topic: '🔔 Doorbell Pressed', // Node Email dùng msg.topic làm Subject nhé!\n        \n        // Nội dung thư thì nhét vào payload\n        payload: `\n            <h2 style=\"color: #2563eb;\">🔔 Doorbell Button Pressed</h2>\n            <p>Someone pressed the doorbell button.</p>\n            <p><strong>Time:</strong> ${new Date(eventData.timestamp).toLocaleString('vi-VN')}</p>\n            ${eventData.image_url ? `<img src=\"${eventData.image_url}\" alt=\"Doorbell Image\" style=\"max-width: 600px; border-radius: 8px;\"/>` : ''}\n            <br/><br/>\n            <p style=\"color: #6b7280; font-size: 12px;\">ESP32 Smart Doorbell</p>\n        `,\n        from: 'ESP32 Doorbell <khoa199939@gmail.com>' // Cái này tùy server có cho override không, nhưng cứ để cũng được\n    });\n}\n\n// Trả về mảng các msg để nó bắn liên thanh cho từng người\nreturn [messages];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1580,
        "y": 220,
        "wires": [
            [
                "email_out_button"
            ]
        ]
    },
