    {
        "id": "mqtt_pir_in",
        "type": "mqtt in",
        "z": "e38e81b07fd63314",
        "name": "PIR High Alert (Burst)",
        "topic": "doorbell/evt/pir_alert",
        "qos": "1",
        "datatype": "json",
        "broker": "0506134bb93b271d",
        "nl": false,
        "rap": false,
        "inputs": 0,
        "x": 160,
        "y": 160,
