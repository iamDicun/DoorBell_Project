        ]
    },
    {
        "id": "9a6f9dfc1cf6fb65",
        "type": "function",
        "z": "bd6bb11c58fb203e",
        "name": "Validate & Prepare",
        "func": "// Node: Function - Validate Speak Command\nnode.warn('📨 [SPEAK] Request received');\nnode.warn('📦 Payload: ' + JSON.stringify(msg.payload));\n\nconst payload = msg.payload;\n\n// Validation\nif (!payload.audio_url) {\n    node.error('❌ Validation failed: audio_url missing');\n    msg.statusCode = 400;\n    msg.payload = {\n        success: false,\n        error: \"Validation failed\",\n        code: \"VALIDATION_ERROR\",\n        details: {\n            field: \"audio_url\",\n            message: \"audio_url is required\"\n        }\n    };\n    return [null, msg]; // Send to error output\n}\n\n// Validate volume\nconst volume = payload.volume || 80;\nif (volume < 0 || volume > 100) {\n    node.error('❌ Validation failed: volume out of range');\n    msg.statusCode = 400;\n    msg.payload = {\n        success: false,\n        error: \"Validation failed\",\n        code: \"VALIDATION_ERROR\",\n        details: {\n            field: \"volume\",\n            message: \"volume must be between 0 and 100\"\n        }\n    };\n    return [null, msg];\n}\n\n// Generate command\nconst commandId = 'cmd_' + Date.now() + '_speak';\nconst timestamp = Math.floor(Date.now() / 1000);\n\n// MQTT payload\nmsg.mqttPayload = {\n    command_id: commandId,\n    audio_url: payload.audio_url,\n    volume: volume,\n    timestamp: timestamp\n};\n\nmsg.commandId = commandId;\nmsg.audioUrl = payload.audio_url;\nmsg.volume = volume;\nmsg.timestamp = timestamp;\nmsg.topic = 'doorbell/cmd/speak';\n\nnode.warn('✅ Validation passed');\nnode.warn('🎵 Audio URL: ' + payload.audio_url);\nnode.warn('🔉 Volume: ' + volume);\nnode.warn('📡 MQTT Topic: ' + msg.topic);\n\nreturn [msg, null]; // Send to success output",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 530,
        "y": 1400,
        "wires": [
            [
                "prepare_speak_mqtt",
                "d6994a03a3653bad"
            ],
            [
                "869e6f35da0d5eef"
            ]
        ]
    },
    {
        "id": "prepare_speak_mqtt",
        "type": "function",
        "z": "bd6bb11c58fb203e",
        "name": "Prepare MQTT Payload",
        "func": "// Set msg.payload for MQTT out node\nnode.warn('📡 [MQTT] Preparing to publish');\nnode.warn('📡 Topic: ' + msg.topic);\nnode.warn('📡 Payload: ' + JSON.stringify(msg.mqttPayload));\n\n// MQTT out node auto-converts object to JSON\\nmsg.payload = msg.mqttPayload;\nreturn msg;",
        "outputs": 1,
