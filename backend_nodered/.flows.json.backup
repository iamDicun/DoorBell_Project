    {
        "id": "generate_siren_command",
        "type": "function",
        "z": "bd6bb11c58fb203e",
        "name": "Generate Siren Command",
        "func": "// Node: Function - Generate Siren Command\nconst commandId = 'cmd_' + Date.now() + '_siren';\nconst timestamp = Math.floor(Date.now() / 1000);\nconst action = msg.payload.action || 'ON';\nconst duration = msg.payload.duration || 15;\n\n// MQTT message\nconst mqttMsg = {\n    payload: {\n        action: action,\n        duration: duration,\n        command_id: commandId,\n        timestamp: timestamp\n    },\n    topic: 'doorbell/cmd/siren',\n    qos: 1\n};\n\n// HTTP response message (preserve req/res)\nconst httpMsg = {\n    req: msg.req,\n    res: msg.res,\n    payload: {\n        success: true,\n        message: 'Siren command sent',\n        command_id: commandId,\n        action: action\n    },\n    statusCode: 200\n};\n\nreturn [mqttMsg, httpMsg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
