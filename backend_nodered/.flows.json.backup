    {
        "id": "send_alert_email",
        "type": "function",
        "z": "e38e81b07fd63314",
        "name": "Send Alert Email",
        "func": "let settings = JSON.parse(msg.payload);\nif (Array.isArray(settings)) settings = settings[0];\n\nif (settings.do_not_disturb === true) return null;\n\nconst recipients = await axios.get(\n    'https://xznnnklhqkccylxxzsdh.supabase.co/rest/v1/email_recipients?is_active=eq.true&notification_types->>pir_alert=eq.true',\n    { headers: { 'apikey': 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh6bm5ua2xocWtjY3lseHh6c2RoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjY5OTEzMDAsImV4cCI6MjA4MjU2NzMwMH0.qucNiuvWiQc-ntPAuBiNKZAphhnReb3e4gnUAhEE1Z8' } }\n);\n\nconst e = msg.eventData;\nconst messages = [];\n\nfor (const r of recipients.data) {\n    messages.push({\n        to: r.email,\n        topic: '⚠️ High Motion Alert',\n        payload: `<h2 style=\"color: #dc2626;\">⚠️ High Motion Alert - Burst Detected</h2><p>Multiple rapid movements detected (${e.count} images captured)</p><p><strong>Time:</strong> ${new Date(e.timestamp).toLocaleString('vi-VN')}</p>${e.image_url ? `<img src=\"${e.image_url}\" style=\"max-width: 600px; border-radius: 8px;\"/>` : ''}<p style=\"color: #6b7280; font-size: 12px;\">ESP32 Smart Doorbell</p>`,\n        from: 'ESP32 Doorbell <khoa199939@gmail.com>'\n    });\n}\n\nreturn [messages];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [
            {
                "var": "axios",
                "module": "axios"
            }
        ],
