    {
        "id": "8c47a7ec593edaf3",
        "type": "http in",
        "z": "bd6bb11c58fb203e",
        "name": "POST /api/commands/siren",
        "url": "/api/commands/siren",
        "method": "post",
        "upload": false,
        "skipBodyParsing": false,
        "swaggerDoc": "",
        "x": 160,
        "y": 1760,
        "wires": [
