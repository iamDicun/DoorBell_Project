    {
        "id": "format_response",
        "type": "function",
        "z": "bd6bb11c58fb203e",
        "name": "Format Response",
        "func": "// Parse response if it's a string\nlet data = msg.payload;\nif (typeof data === 'string') {\n    try {\n        data = JSON.parse(data);\n    } catch (e) {\n        data = [];\n    }\n}\n\nmsg.payload = {\n    success: true,\n    data: data,\n    count: Array.isArray(data) ? data.length : 0\n};\nmsg.statusCode = 200;\nreturn msg;",
        "outputs": 1,
