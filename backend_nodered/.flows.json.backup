    {
        "id": "filter_send_pir",
        "type": "function",
        "z": "e38e81b07fd63314",
        "name": "Filter & Send PIR",
        "func": "let settings = JSON.parse(msg.payload);\nif (Array.isArray(settings)) settings = settings[0];\n\nif (settings.do_not_disturb === true) {\n    return null;\n}\n\n// Get recipients\nconst recipients = await axios.get(\n    'https://xznnnklhqkccylxxzsdh.supabase.co/rest/v1/email_recipients?is_active=eq.true&notification_types->>pir=eq.true',\n    {\n        headers: {\n            'apikey': 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh6bm5ua2xocWtjY3lseHh6c2RoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjY5OTEzMDAsImV4cCI6MjA4MjU2NzMwMH0.qucNiuvWiQc-ntPAuBiNKZAphhnReb3e4gnUAhEE1Z8'\n        }\n    }\n);\n\nconst eventData = msg.eventData;\nconst messages = [];\n\nfor (const r of recipients.data) {\n    messages.push({\n        to: r.email,\n        topic: '👤 Motion Detected',\n        payload: `<h2>👤 Motion Detected</h2><p>${eventData.description}</p><p><strong>Time:</strong> ${new Date(eventData.timestamp).toLocaleString('vi-VN')}</p><p style=\"color: #6b7280; font-size: 12px;\">ESP32 Smart Doorbell</p>`,\n        from: 'ESP32 Doorbell <khoa199939@gmail.com>'\n    });\n}\n\nreturn [messages];",
