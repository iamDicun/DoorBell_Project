    {
        "id": "new_validate_settings",
        "type": "function",
        "z": "bd6bb11c58fb203e",
        "name": "Validate & Update DB",
        "func": "const payload = msg.payload;\n\n// Validate volume\nif (payload.speaker_volume !== undefined && (payload.speaker_volume < 0 || payload.speaker_volume > 100)) {\n    msg.statusCode = 400;\n    msg.payload = { success: false, error: \"speaker_volume must be 0-100\" };\n    return [null, msg];\n}\n\n// Build update\nconst update = { updated_at: new Date().toISOString() };\nif (payload.alarm_enabled !== undefined) update.alarm_enabled = payload.alarm_enabled;\nif (payload.speaker_volume !== undefined) update.speaker_volume = payload.speaker_volume;\nif (payload.pir_enabled !== undefined) update.pir_enabled = payload.pir_enabled;\nif (payload.notifications_enabled !== undefined) update.notifications_enabled = payload.notifications_enabled;\nif (payload.do_not_disturb !== undefined) update.do_not_disturb = payload.do_not_disturb;\nif (payload.alarm_auto_play !== undefined) update.alarm_auto_play = payload.alarm_auto_play;\nif (payload.temp_enabled !== undefined) update.temp_enabled = payload.temp_enabled;\n\nmsg.url = 'https://xznnnklhqkccylxxzsdh.supabase.co/rest/v1/device_settings?id=eq.1';\nmsg.method = 'PATCH';\nmsg.payload = update;\nmsg.headers = {\n    'apikey': 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh6bm5ua2xocWtjY3lseHh6c2RoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjY5OTEzMDAsImV4cCI6MjA4MjU2NzMwMH0.qucNiuvWiQc-ntPAuBiNKZAphhnReb3e4gnUAhEE1Z8',\n    'Authorization': 'Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh6bm5ua2xocWtjY3lseHh6c2RoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjY5OTEzMDAsImV4cCI6MjA4MjU2NzMwMH0.qucNiuvWiQc-ntPAuBiNKZAphhnReb3e4gnUAhEE1Z8',\n    'Content-Type': 'application/json'\n};\n\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
