        "func": "node.warn('🔍 Voice Insert Response:');\nnode.warn('Status Code: ' + msg.statusCode);\nnode.warn('Payload: ' + JSON.stringify(msg.payload));\nnode.warn('Headers: ' + JSON.stringify(msg.headers));\nreturn msg;",
