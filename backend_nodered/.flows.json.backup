    {
        "id": "send_voice_email",
        "type": "function",
        "z": "0f2c315966152f10",
        "name": "Send Voice Email",
        "func": "let settings = JSON.parse(msg.payload);\nif (Array.isArray(settings)) settings = settings[0];\n\nif (settings.do_not_disturb === true) return null;\n\nconst recipients = await axios.get(\n    'https://xznnnklhqkccylxxzsdh.supabase.co/rest/v1/email_recipients?is_active=eq.true&notification_types->>voice=eq.true',\n    { headers: { 'apikey': 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh6bm5ua2xocWtjY3lseHh6c2RoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjY5OTEzMDAsImV4cCI6MjA4MjU2NzMwMH0.qucNiuvWiQc-ntPAuBiNKZAphhnReb3e4gnUAhEE1Z8' } }\n);\n\nconst e = msg.eventData;\nconst messages = [];\n\nfor (const r of recipients.data) {\n    messages.push({\n        to: r.email,\n        topic: '🎤 New Voice Message',\n        payload: `<h2 style=\"color: #7c3aed;\">🎤 New Voice Message Received</h2><p>Someone left a voice message at your doorbell.</p><p><strong>Time:</strong> ${new Date(e.timestamp).toLocaleString('vi-VN')}</p><p><strong>Duration:</strong> ${e.duration} seconds</p><p><a href=\"${e.audio_url}\" style=\"background: #7c3aed; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; display: inline-block; margin-top: 10px;\">🎧 Listen to Voice Message</a></p><p style=\"color: #6b7280; font-size: 12px; margin-top: 20px;\">ESP32 Smart Doorbell</p>`,\n        from: 'ESP32 Doorbell <khoa199939@gmail.com>'\n    });\n}\n\nreturn [messages];",
