    {
        "id": "prepare_sensor_insert",
        "type": "function",
        "z": "a7b8c9d0e1f2g3h4",
        "name": "Prepare Sensor Insert",
        "func": "const payload = msg.payload;\n\n// Handle both formats:\n// doorbell/sensor/temp: {value: 31.5, unit: \"C\", device_id: ..., timestamp: ...}\n// doorbell/telemetry: {temperature: 29.95, motion: false}\nconst temperature = payload.value || payload.temperature;\nconst timestamp = payload.timestamp || Math.floor(Date.now() / 1000);\n\nif (!temperature) {\n    node.warn('Invalid sensor payload: missing temperature/value');\n    return null;\n}\n\nmsg.payload = {\n    sensor_type: 'temperature',\n    temperature: temperature,\n    humidity: null,\n    created_at: new Date(timestamp * 1000).toISOString(),\n    metadata: {\n        device_id: payload.device_id || 'ESP32_DOORBELL',\n        raw_timestamp: timestamp,\n        unit: payload.unit || 'C'\n    }\n};\n\nmsg.headers = {\n    'apikey': 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh6bm5ua2xocWtjY3lseHh6c2RoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjY5OTEzMDAsImV4cCI6MjA4MjU2NzMwMH0.qucNiuvWiQc-ntPAuBiNKZAphhnReb3e4gnUAhEE1Z8',\n    'Authorization': 'Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh6bm5ua2xocWtjY3lseHh6c2RoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjY5OTEzMDAsImV4cCI6MjA4MjU2NzMwMH0.qucNiuvWiQc-ntPAuBiNKZAphhnReb3e4gnUAhEE1Z8',\n    'Content-Type': 'application/json',\n    'Prefer': 'return=representation'\n};\n\nreturn msg;",
