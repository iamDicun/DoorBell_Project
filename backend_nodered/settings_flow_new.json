    {
        "id": "new_publish_and_respond",
        "type": "function",
        "z": "bd6bb11c58fb203e",
        "name": "Publish to MQTT & Format Response",
        "func": "let data = msg.payload;\nif (typeof data === 'string') {\n    data = JSON.parse(data);\n}\n\nconst settings = Array.isArray(data) ? data[0] : data;\n\n// Publish to MQTT\nconst mqttMsg = {\n    payload: {\n        action: 'sync_settings',\n        speaker_volume: settings.speaker_volume ?? 75,\n        pir_enabled: settings.pir_enabled !== false,\n        alarm_enabled: settings.alarm_enabled !== false,\n        notifications_enabled: settings.notifications_enabled !== false,\n        do_not_disturb: settings.do_not_disturb === true,\n        alarm_auto_play: settings.alarm_auto_play !== false,\n        temp_enabled: settings.temp_enabled !== false\n    },\n    topic: 'doorbell/cmd/settings',\n    qos: 1\n};\n\n// HTTP response\nconst httpMsg = {\n    payload: {\n        success: true,\n        message: 'Settings updated',\n        data: settings\n    },\n    statusCode: 200\n};\n\nreturn [mqttMsg, httpMsg];",
